# Copia in .env (mai committato) e compila. Tutte le chiavi restano lato server.

# Backend
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/monstertrade
CORS_ORIGINS=["http://localhost:3000"]

# Gestione del rischio (i limiti massimi del piano non si possono superare)
CAPITAL_EUR=1000
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MAX_OPEN_POSITIONS=3
MAX_LEV3_EXPOSURE=0.30
MIN_ORDER_EUR=10

# Notifiche delle nuove proposte (facoltative): argomento privato di ntfy.sh
NTFY_TOPIC=

# Accesso: segreto condiviso tra frontend e API (almeno 32 caratteri casuali)
API_SHARED_SECRET=

# Trading 212 (sola lettura): chiave con soli permessi di lettura
T212_API_KEY=
T212_API_SECRET=
T212_ENV=live

# Fonti dati (piani gratuiti)
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Frontend (Vercel): tutto letto solo lato server
API_URL=http://localhost:8000
# Hash della password: node frontend/scripts/hash-password.mjs
APP_PASSWORD_HASH=
# Firma delle sessioni (almeno 32 caratteri casuali)
SESSION_SECRET=
