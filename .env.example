# Copia in .env (mai committato) e compila. Tutte le chiavi restano lato server.

# Backend
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/monstertrade
CORS_ORIGINS=["http://localhost:3000"]

# Fonti dati (piani gratuiti)
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Frontend: solo valori pubblici, mai chiavi
NEXT_PUBLIC_API_URL=http://localhost:8000
